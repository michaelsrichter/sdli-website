---
import { getCollection } from 'astro:content';
import ContentPage from '../layouts/ContentPage.astro';
import Photo from '../components/Photo.astro';
import PersonCard from '../components/PersonCard.astro';
import EventCard from '../components/EventCard.astro';
import { getEventGroups } from '../lib/content';
import { photos } from '../lib/photos';

const teachers = await getCollection('instructors');
const { upcoming, past } = await getEventGroups();
const lastSeen = (id: string) => past.find((e) => (e.details.instructorNames ?? []).includes(id))?.date ?? '';
teachers.sort((a, b) => lastSeen(b.id).localeCompare(lastSeen(a.id)));
const withLesson = upcoming.filter((e) => e.hasLesson).slice(0, 4);
---
<ContentPage id="lessons" pageType="lessons">
  <section aria-labelledby="next-lessons">
    <h2 id="next-lessons">Next lessons</h2>
    <ul class="event-list mt-5" data-upcoming-list="lessons">{withLesson.map((e) => <EventCard event={e} />)}</ul>
    <p class="mt-3"><a href="/events/?lesson=yes">All upcoming lessons</a></p>
  </section>
  <section aria-labelledby="teachers-h">
    <h2 id="teachers-h">Teachers</h2>
    <ul class="grid grid--2 mt-5" role="list">{teachers.map((t) => <PersonCard person={t} />)}</ul>
  </section>
  <Fragment slot="aside">
    <Photo photo={photos.polkaDots} sizes="(min-width: 56rem) 35vw, 92vw" widths={[480, 720, 960]} />
  </Fragment>
</ContentPage>
