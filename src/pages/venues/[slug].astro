---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventCard from '../../components/EventCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import Icon from '../../components/Icon.astro';
import { getEventGroups, getSettings } from '../../lib/content';
import { breadcrumbJsonLd } from '../../lib/seo';

export async function getStaticPaths() {
  const venues = await getCollection('venues');
  return venues.map((v) => ({ params: { slug: v.id }, props: { venue: v } }));
}
const { venue } = Astro.props;
const { Content } = await render(venue);
const v = venue.data;
const settings = await getSettings();
const { upcoming, past } = await getEventGroups();
const here = upcoming.filter((e) => e.venueEntry?.id === venue.id).slice(0, 8);
const recent = past.filter((e) => e.venueEntry?.id === venue.id).slice(0, 4);
const full = `${v.name}, ${v.address}, ${v.city}, ${v.state} ${v.postalCode ?? ''}`.trim();
const google = v.directionsUrl ?? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(full)}`;
const apple = `https://maps.apple.com/?daddr=${encodeURIComponent(full)}`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Venues', href: '/venues/' },
  { name: v.name, href: `/venues/${venue.id}/` },
];
const site = Astro.site!;
const placeLd = {
  '@context': 'https://schema.org',
  '@type': 'Place',
  '@id': new URL(`/venues/${venue.id}/#place`, site).toString(),
  name: v.name,
  telephone: v.phone,
  address: { '@type': 'PostalAddress', streetAddress: v.address, addressLocality: v.city, addressRegion: v.state, postalCode: v.postalCode, addressCountry: 'US' },
  ...(v.latitude !== undefined && v.longitude !== undefined ? { geo: { '@type': 'GeoCoordinates', latitude: v.latitude, longitude: v.longitude } } : {}),
  url: new URL(`/venues/${venue.id}/`, site).toString(),
};
const tel = settings.hotlinePhone.replace(/[^0-9]/g, '');
---
<BaseLayout title={v.seoTitle ?? `${v.name}, ${v.city}`} description={v.seoDescription ?? `${v.name}, ${v.address}, ${v.city}, ${v.state}. Directions and upcoming SDLI swing dances.`} pageType="venue" jsonLd={[placeLd, breadcrumbJsonLd(crumbs, site)]}>
  <PageHeader title={v.name} lede={`${v.address}, ${v.city}, ${v.state} ${v.postalCode ?? ''}`} crumbs={crumbs}>
    <div class="btn-row mt-5">
      <a class="btn btn--primary" href={google} target="_blank" rel="noopener" data-track="get_directions" data-track-method="google" data-track-location="venue"><Icon name="directions" />Google Maps<span class="visually-hidden"> (opens in a new tab)</span></a>
      <a class="btn btn--secondary" href={apple} target="_blank" rel="noopener" data-track="get_directions" data-track-method="apple" data-track-location="venue"><Icon name="pin" />Apple Maps<span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
  </PageHeader>
  <div class="container section">
    <div class="split">
      <div class="stack-l">
        <section aria-labelledby="upcoming-here">
          <h2 id="upcoming-here">Upcoming here</h2>
          {here.length ? (
            <ul class="event-list mt-5" data-upcoming-list="venue">{here.map((e) => <EventCard event={e} />)}</ul>
          ) : (
            <EmptyState title="No upcoming events are listed here"><p><a href="/events/">See all events</a></p></EmptyState>
          )}
        </section>
        {recent.length > 0 && (
          <section aria-labelledby="recent-here">
            <h2 id="recent-here" class="h3">Recently</h2>
            <ul class="event-list mt-3">{recent.map((e) => <EventCard event={e} past />)}</ul>
          </section>
        )}
      </div>
      <aside class="stack">
        <section class="panel" aria-labelledby="venue-info">
          <h2 id="venue-info">Venue information</h2>
          <dl class="dl">
            <div><dt>Address</dt><dd><address>{v.address}<br />{v.city}, {v.state} {v.postalCode}</address></dd></div>
            {v.phone && <div><dt>Venue phone</dt><dd><a href={`tel:+1${v.phone.replace(/[^0-9]/g, '')}`}>{v.phone}</a></dd></div>}
            <div><dt>Parking</dt><dd>{v.parkingNotes ?? <>Call the {settings.hotlineLabel} at <a href={`tel:+1${tel}`}>{settings.hotlinePhone}</a> for parking details.</>}</dd></div>
            <div><dt>Accessibility</dt><dd>{v.accessibilityNotes ?? <>Have an access need? Call <a href={`tel:+1${tel}`}>{settings.hotlinePhone}</a> or email <a href={`mailto:${settings.email}`}>{settings.email}</a> before you visit and we will do our best to help.</>}</dd></div>
          </dl>
        </section>
        <div class="prose"><Content /></div>
      </aside>
    </div>
  </div>
</BaseLayout>
