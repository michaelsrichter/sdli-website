---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  /** Crop to an aspect ratio (width / height) so card collections stay consistent. */
  aspect?: number;
  /** Crop focus for cover crops: "attention" picks the most interesting region (faces). */
  position?: string;
}
const { src, alt, widths, sizes, class: className, loading = 'lazy', aspect, position = 'attention' } = Astro.props;
const usable = widths.filter((w) => w <= src.width);
const finalWidths = usable.length ? usable : [src.width];
const maxW = Math.max(...finalWidths);
const height = aspect ? Math.round(maxW / aspect) : Math.round((maxW * src.height) / src.width);
---
<Picture
  src={src}
  alt={alt}
  formats={['webp']}
  fallbackFormat="jpg"
  widths={finalWidths}
  sizes={sizes}
  width={maxW}
  height={height}
  fit={aspect ? 'cover' : undefined}
  position={aspect ? position : undefined}
  loading={loading}
  decoding={loading === 'eager' ? 'sync' : 'async'}
  fetchpriority={loading === 'eager' ? 'high' : undefined}
  class={className}
  quality={72}
/>
