---
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/events/', label: 'Events' },
  { href: '/new-to-swing/', label: 'New to Swing?' },
  { href: '/lessons/', label: 'Lessons' },
  { href: '/venues/', label: 'Venues' },
  { href: '/about/', label: 'About SDLI' },
  { href: '/membership/', label: 'Membership' },
  { href: '/gallery/', label: 'Gallery' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Swing Dance Long Island home">
      <Logo class="brand__mark" />
      <span class="brand__text">
        <span class="brand__name">Swing Dance Long Island</span>
        <span class="brand__abbr">SDLI · Volunteer-run nonprofit</span>
      </span>
    </a>
    <nav class="nav" aria-label="Main">
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-panel" data-nav-toggle>
        <Icon name="menu" />
        <span>Menu</span>
      </button>
      <div class="nav__panel" id="nav-panel" data-nav-panel>
        <ul class="nav__list">
          {nav.map((item) => (
            <li>
              <a class="nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
</header>
<script>
  import '../scripts/nav';
</script>
