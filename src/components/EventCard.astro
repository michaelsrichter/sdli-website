---
import type { ResolvedEvent } from '../lib/content';
import Icon from './Icon.astro';
import StatusBadge from './StatusBadge.astro';
import TicketDate from './TicketDate.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { formatTime, formatDateLong } from '../lib/time';
import { formatPrice } from '../lib/event-core';

interface Props {
  event: ResolvedEvent;
  headingLevel?: 'h2' | 'h3' | 'h4';
  past?: boolean;
}
const { event: e, headingLevel = 'h3', past = false } = Astro.props;
const Heading = headingLevel;
const status = past ? e.effectiveStatus : e.status;
const lesson = e.details.lessonStartTime ? `Lesson ${formatTime(e.details.lessonStartTime)}` : undefined;
const dance = e.details.danceStartTime ? `Dancing ${formatTime(e.details.danceStartTime)}` : e.timeTba ? 'Time to be announced' : formatTime(e.startLocal.slice(11));
const fromPrice = [e.admission.member, e.admission.student, e.admission.nonMember].filter((n): n is number => typeof n === 'number');
const priceLabel = e.admission.free ? 'Free' : fromPrice.length ? `${formatPrice(Math.min(...fromPrice))}–${formatPrice(Math.max(...fromPrice))}` : undefined;
const filterData = {
  'data-event': '',
  'data-date': e.date,
  'data-end': String(e.end.getTime()),
  'data-status': e.status,
  'data-types': (e.details.eventTypes ?? []).join(' '),
  'data-styles': e.styles.map((s) => s.id).join(' '),
  'data-venue': e.venueEntry?.id ?? '',
  'data-lesson': e.hasLesson ? 'yes' : 'no',
  'data-level': e.details.experienceLevel ?? 'all-levels',
  'data-band': e.band ? 'yes' : 'no',
};
---
<li class:list={['event-card', `event-card--${status}`]} {...filterData}>
  <TicketDate date={e.date} muted={past || status === 'cancelled'} small />
  <div class="event-card__body">
    <div>
      <StatusBadge status={status} />
    </div>
    <Heading class="event-card__title">
      <a href={e.url}>
        <span class="visually-hidden">{formatDateLong(e.date)}: </span>{e.title}{status === 'cancelled' && <span class="visually-hidden"> (cancelled)</span>}
      </a>
    </Heading>
    {status === 'cancelled' && e.cancelledMessage && <p class="event-card__note">{e.cancelledMessage}</p>}
    <p class="event-card__meta">
      {lesson && <span><Icon name="clock" />{lesson}</span>}
      <span><Icon name="music" />{dance}</span>
      {e.location.city && <span><Icon name="pin" />{e.location.name ? `${e.location.name}, ${e.location.city}` : e.location.city}</span>}
      {!past && priceLabel && <span><Icon name="ticket" />{priceLabel}</span>}
    </p>
    {(e.band || e.instructors.length > 0) && (
      <p class="event-card__meta">
        {e.band && <span><Icon name="star" />Live band: {e.band.name}</span>}
        {e.instructors.length > 0 && <span><Icon name="people" />Teacher: {e.instructors.map((i) => i.name).join(', ')}</span>}
      </p>
    )}
  </div>
  {e.image && e.imageAlt && e.imageFrom !== 'series' && (
    <div class="event-card__thumb">
      <ResponsiveImage src={e.image} alt="" widths={[208]} sizes="104px" aspect={1} />
    </div>
  )}
</li>
