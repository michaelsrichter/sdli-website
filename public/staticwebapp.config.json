{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "trailingSlash": "auto",
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/index.php", "redirect": "/", "statusCode": 301 },
    { "route": "/index.php/sdli/news/membership*", "redirect": "/membership/", "statusCode": 301 },
    { "route": "/index.php/sdli/news/contact*", "redirect": "/contact/", "statusCode": 301 },
    { "route": "/index.php/sdli/news/email*", "redirect": "/contact/#email-list", "statusCode": 301 },
    { "route": "/index.php/sdli/news", "redirect": "/about/", "statusCode": 301 },
    { "route": "/index.php/sdli/events/swing_dance_every_tuesday*", "redirect": "/events/series/tuesday-night-swing/", "statusCode": 301 },
    { "route": "/index.php/sdli/events", "redirect": "/events/", "statusCode": 301 },
    { "route": "/index.php/sdli/calendar", "redirect": "/events/calendar/", "statusCode": 301 },
    { "route": "/index.php/sdli/events_archive", "redirect": "/events/past/", "statusCode": 301 },
    { "route": "/index.php/sdli/venues/huntingtin_moose_lodge*", "redirect": "/venues/huntington-moose-lodge/", "statusCode": 301 },
    { "route": "/index.php/sdli/venues", "redirect": "/venues/", "statusCode": 301 },
    { "route": "/index.php/sdli/bands", "redirect": "/performers/", "statusCode": 301 },
    { "route": "/index.php/sdli/sponsor", "redirect": "/about/#friends", "statusCode": 301 },
    { "route": "/index.php/sdli/rss_2.0*", "redirect": "/events/rss.xml", "statusCode": 301 },
    { "route": "/index.php/sdli/atom*", "redirect": "/events/rss.xml", "statusCode": 301 },
    { "route": "/_astro/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/admin/*", "headers": { "Content-Security-Policy": "__ADMIN_CSP__", "Cache-Control": "no-cache" } },
    { "route": "/*.ics", "headers": { "Cache-Control": "public, max-age=900" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "mimeTypes": {
    ".ics": "text/calendar; charset=utf-8",
    ".webmanifest": "application/manifest+json",
    ".txt": "text/plain; charset=utf-8",
    ".yml": "text/yaml; charset=utf-8",
    ".xml": "application/xml; charset=utf-8"
  },
  "globalHeaders": {
    "Content-Security-Policy": "__SITE_CSP__",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()",
    "Cross-Origin-Opener-Policy": "same-origin-allow-popups",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  }
}
